# Dwello Homes Firebase Cloud Functions Environment Variables
# Copy to functions/.env for local emulation or configure in Cloud Functions / Secret Manager.
# NEVER commit real secrets or private service-account JSON keys to git or Android source code.

# Named Cloud Firestore Enterprise database ID for Dwello Home (dwello-home)
DWELLO_FIRESTORE_DATABASE_ID=ai-studio-android-dwelloho-b885f2f3-86cf-4fd4-b080-a65e5fa25ef9

# Firebase Storage bucket for property photos
DWELLO_STORAGE_BUCKET=dwello-home.firebasestorage.app

# Comma-separated allowed browser origins for the separate Admin Web App (leave blank for mobile-only / curl)
DWELLO_ALLOWED_ORIGINS=https://dwello-home.web.app,https://dwello-home.firebaseapp.com

# Default market city
DWELLO_DEFAULT_CITY=Benin City

# Optional cryptographic pepper mixed with scrypt password hashes (store via `firebase functions:secrets:set DWELLO_AUTH_PEPPER` in production)
DWELLO_AUTH_PEPPER=

# One-time CLI admin bootstrap variables ONLY (used by `node scripts/bootstrapAdmin.js`, never deployed to public endpoints)
# DWELLO_BOOTSTRAP_ADMIN_PHONE=+2348000000001
# DWELLO_BOOTSTRAP_ADMIN_PASSWORD=
# DWELLO_BOOTSTRAP_ADMIN_NAME=Dwello Platform Admin
