rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Global Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPropertyPhoto() {
      return request.resource != null &&
             request.resource.size > 0 &&
             request.resource.size <= 5 * 1024 * 1024 &&
             request.resource.contentType != null &&
             request.resource.contentType.matches('^image/(jpeg|jpg|png|webp|heic|heif)$');
    }

    // Property photos scoped by landlordId and propertyId
    match /property-images/{landlordId}/{propertyId}/{fileName} {
      allow read: if isSignedIn() && isValidId(landlordId) && isValidId(propertyId);
      allow create, update: if isSignedIn() &&
                               request.auth.uid == landlordId &&
                               isValidId(propertyId) &&
                               isValidId(fileName.split('.')[0]) &&
                               isValidPropertyPhoto();
      allow delete: if isSignedIn() && request.auth.uid == landlordId;
    }
  }
}
